# Timestamped config backups taken before each --apply. Local safety net, not history.
/backups/*
!/backups/.gitkeep

__pycache__/
*.pyc

# Captured logs. Multi-megabyte game output, reproducible by re-running; the
# analysis belongs in history, the raw bytes do not.
/captures/*
!/captures/.gitkeep

# Generated benchmark reports, pzauto's bookkeeping and its INDEX.md. Derived from
# captures, which are themselves ignored -- regenerate with `pzauto.py --once` --
# and they describe one PC's sessions, so they stay on that PC.
/reports/*
!/reports/.gitkeep
captures/*_process.csv

# Zipped single-player saves from pzsavebackup.py (pztail --save-backups). They are
# copies of your saves: private, large, and never history.
/save-backups/
