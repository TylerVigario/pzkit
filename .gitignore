# Timestamped config backups taken before each --apply. Local safety net, not history.
/backups/*
!/backups/.gitkeep

__pycache__/
*.pyc

# Captured logs. Multi-megabyte game output, reproducible by re-running; the
# analysis belongs in history, the raw bytes do not.
/captures/*
!/captures/.gitkeep

# Generated benchmark reports and pzauto's bookkeeping. Derived from captures,
# which are themselves ignored -- regenerate with `pzauto.py --once`. INDEX.md
# is kept, because the one-line-per-session trend is the part worth reading in
# six months and it is small.
/reports/*
!/reports/.gitkeep
!/reports/INDEX.md
captures/*_process.csv
